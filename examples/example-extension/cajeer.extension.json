{
  "name": "@cajeerbots/example-extension",
  "version": "1.0.0-rc.5",
  "displayName": "Пример расширения",
  "description": "Рабочий пример расширения CajeerBots с runtime hook, storage и outbound event.",
  "engine": {
    "apiVersion": "1.0.0-rc.5",
    "range": ">=1.0.0-rc.5 <2.0.0"
  },
  "permissions": ["settings:read"],
  "hooks": ["extension.enabled", "webhook.received", "interaction.*"],
  "entry": "./dist/index.js",
  "capabilities": ["runtime-hooks", "storage", "events"],
  "commands": [
    {
      "name": "example_status",
      "description": "Проверка example extension",
      "templateKey": "system.status",
      "scopes": []
    }
  ]
}
