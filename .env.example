NODE_ENV=development
APP_NAME=CajeerBots
APP_LANGUAGE=ru
APP_HOST=0.0.0.0
APP_PORT=3000
APP_PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgresql://cajeerbots:cajeerbots@localhost:5432/cajeerbots?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-development-only-32-symbols
JWT_ACCESS_TTL_SECONDS=3600
API_TOKEN_PEPPER=change-me-development-only-32-symbols
SECRETS_ENCRYPTION_KEY=change-me-development-only-32-symbols
CAJEER_ADMIN_TOKEN=change-me-development-only-admin-token
WEBHOOK_SIGNING_SECRET=change-me-development-only-webhook-secret

BOT_MODE=polling
BOT_WEBHOOK_HOST=0.0.0.0
BOT_WEBHOOK_PORT=3101
BOT_WEBHOOK_PUBLIC_URL=http://localhost:3101
BOT_RUNTIME_HEARTBEAT_MS=15000
BOT_RUNTIME_STALE_MS=60000
VK_CALLBACK_CONFIRMATION=
CAJEER_DEFAULT_COMMUNITY_ID=
TELEGRAM_BOT_TOKEN=
VK_BOT_TOKEN=
DISCORD_BOT_TOKEN=

QUEUE_DRIVER=redis
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

PROMETHEUS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cajeerbots

IMPORT_EXPORT_MAX_BYTES=5000000

EXTENSIONS_ROOT=./extensions
EXTENSION_RUNTIME_ENABLED=true

# 0.6.0 security hardening
JWT_REFRESH_TTL_SECONDS=2592000
PASSWORD_PEPPER=change-me-development-only-password-pepper
REFRESH_TOKEN_PEPPER=change-me-development-only-refresh-pepper
RECOVERY_CODE_PEPPER=change-me-development-only-recovery-pepper
TOTP_ISSUER=CajeerBots
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW=1 minute

# Event API 0.9.0
EVENT_API_WORKER_INTERVAL_MS=5000
EVENT_API_WORKER_BATCH_SIZE=25
EVENT_API_DEFAULT_RETENTION_DAYS=30

# Scheduler / Maintenance
SCHEDULER_WORKER_INTERVAL_MS=10000
SCHEDULER_WORKER_BATCH_SIZE=10
SCHEDULER_LOCK_SECONDS=600


# Backup / Storage Catalog 0.14.0
BACKUP_RETENTION_DAYS=30
BACKUP_OBJECT_PREFIX=backups
BACKUP_WORKER_INTERVAL_MS=60000
BACKUP_DELETED_OBJECT_RETENTION_DAYS=7


# Observability / production diagnostics
OBSERVABILITY_WORKER_INTERVAL_MS=30000
OBSERVABILITY_RETENTION_DAYS=14
OBSERVABILITY_PROBE_BATCH_SIZE=20

# Deployment / Release Operations 0.15.0
DEPLOYMENT_DEFAULT_TARGET=docker.production
DEPLOYMENT_ENV_FILE=.env.production
DEPLOYMENT_COMPOSE_FILE=docker-compose.prod.yml
DEPLOYMENT_NGINX_SERVER_NAME=bots.example.cajeer.ru
RELEASE_CHANNEL=alpha

# 0.18.0-beta.1 release gates
RELEASE_GATES_ROOT_DIR=.
RELEASE_GATES_VERSION=0.18.0-beta.1
RELEASE_GATES_CHANNEL=beta

# Integration Tests Worker
INTEGRATION_TESTS_WORKER_INTERVAL_MS=15000
INTEGRATION_TESTS_WORKER_BATCH_SIZE=3

# Security audit / beta 3 hardening
SECURITY_AUDIT_SCHEDULE="cron:30 8 * * *"
SECURITY_AUDIT_SECRET_MAX_AGE_DAYS=90
SECURITY_AUDIT_SESSION_MAX_AGE_DAYS=30
SECURITY_AUDIT_RATE_LIMIT_WINDOW_HOURS=24
SECURITY_AUDIT_RATE_LIMIT_MAX_VIOLATIONS=100
