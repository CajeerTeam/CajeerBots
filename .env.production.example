# Используйте scripts/setup-production.mjs для создания реальных секретов.
NODE_ENV=production
APP_PUBLIC_URL=https://bots.example.org
BOT_WEBHOOK_PUBLIC_URL=https://bots.example.org
POSTGRES_USER=cajeerbots
POSTGRES_DB=cajeerbots
POSTGRES_PASSWORD=replace-with-generated-password
DATABASE_URL=postgresql://cajeerbots:replace-with-generated-password@postgres:5432/cajeerbots?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-generated-secret
API_TOKEN_PEPPER=replace-with-generated-secret
SECRETS_ENCRYPTION_KEY=replace-with-generated-secret
PASSWORD_PEPPER=replace-with-generated-secret
REFRESH_TOKEN_PEPPER=replace-with-generated-secret
RECOVERY_CODE_PEPPER=replace-with-generated-secret
CAJEER_ADMIN_TOKEN=replace-with-generated-secret
WEBHOOK_SIGNING_SECRET=replace-with-generated-secret
APP_HOST=0.0.0.0
APP_PORT=3000
BOT_MODE=polling
BOT_WEBHOOK_PORT=3101
# Per-account webhook credentials JSON (see RELEASE_VALIDATION_1.0.0-rc.3.md).
BOT_WEBHOOK_CREDENTIALS={}
WORKER_HEALTH_PORT=3102
QUEUE_DRIVER=redis
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/var/lib/cajeerbots/storage
EXTENSIONS_ROOT=/var/lib/cajeerbots/extensions
OTEL_ENABLED=false
PROMETHEUS_ENABLED=true
RELEASE_CHANNEL=rc
RELEASE_GATES_VERSION=1.0.0-rc.3
RELEASE_GATES_CHANNEL=rc
