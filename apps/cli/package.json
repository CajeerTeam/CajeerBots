{
  "name": "@cajeerbots/cli",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cajeerbots/config": "workspace:*",
    "@cajeerbots/extension-sdk": "workspace:*",
    "@cajeerbots/observability": "workspace:*",
    "@cajeerbots/security": "workspace:*",
    "@cajeerbots/db": "workspace:*",
    "@cajeerbots/message-core": "workspace:*",
    "@cajeerbots/registry": "workspace:*",
    "@cajeerbots/scheduler": "workspace:*",
    "@cajeerbots/devtools": "workspace:*",
    "@cajeerbots/backup": "workspace:*",
    "@cajeerbots/storage": "workspace:*",
    "@cajeerbots/deployment": "workspace:*",
    "@cajeerbots/contracts": "workspace:*",
    "@cajeerbots/docs": "workspace:*",
    "@cajeerbots/release-gates": "workspace:*",
    "@cajeerbots/integration-tests": "workspace:*",
    "@cajeerbots/security-audit": "workspace:*",
    "@cajeerbots/release-candidate": "workspace:*",
    "commander": "13.0.0",
    "@cajeerbots/interaction-core": "workspace:*",
    "@cajeerbots/extension-runtime": "workspace:*",
    "@cajeerbots/event-bus": "workspace:*",
    "@cajeerbots/sdk": "workspace:*"
  },
  "main": "dist/main.js",
  "bin": {
    "cajeer": "dist/main.js"
  }
}
