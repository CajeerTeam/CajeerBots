{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "apps/*/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "examples/*/src/**/*.ts",
    "prisma/seed.ts",
    "*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "prisma/generated/**",
    "coverage"
  ]
}
