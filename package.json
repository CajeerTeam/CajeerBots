{
  "name": "cajeerbots",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Русскоязычная TypeScript-first платформа для расширения, автоматизации и управления сообществами через Telegram, VK и Discord.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "cajeer": "tsx apps/cli/src/main.ts",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "release:dist": "node scripts/release-dist.mjs",
    "contracts:check": "tsx apps/cli/src/main.ts contracts check",
    "contracts:sdk": "tsx apps/cli/src/main.ts contracts sdk:generate --write"
  },
  "dependencies": {
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@prisma/client": "^6.0.0",
    "bullmq": "^5.0.0",
    "commander": "^13.0.0",
    "discord.js": "^14.0.0",
    "fastify": "^5.0.0",
    "grammy": "^1.0.0",
    "ioredis": "^5.0.0",
    "jose": "^5.0.0",
    "nanoid": "^5.0.0",
    "pino": "^9.0.0",
    "prom-client": "^15.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "supertest": "^7.0.0",
    "vk-io": "^4.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "author": "SkiF4er",
  "contributors": [
    "markovav"
  ],
  "maintainers": [
    "Cajeer Team"
  ],
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
