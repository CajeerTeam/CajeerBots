{
  "name": "cajeerbots",
  "version": "1.0.0-rc.6",
  "private": true,
  "description": "Русскоязычная TypeScript-first платформа для расширения, автоматизации и управления сообществами через Telegram, VK и Discord.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.16.0 <23",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "dev": "pnpm build && node --env-file-if-exists=.env scripts/dev-runtime.mjs",
    "build": "pnpm prisma:generate && pnpm -r build",
    "lint": "eslint apps packages examples prisma scripts *.ts --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.e2e.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "cajeer": "node --env-file-if-exists=.env apps/cli/dist/main.js",
    "db:seed": "pnpm prisma:seed",
    "prisma:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "release:dist": "node scripts/release-dist.mjs",
    "contracts:check": "tsx apps/cli/src/main.ts contracts check",
    "contracts:sdk": "tsx apps/cli/src/main.ts contracts sdk:generate --write",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "start:api": "node --env-file-if-exists=.env apps/api/dist/main.js",
    "start:bot": "node --env-file-if-exists=.env apps/bot-runtime/dist/main.js",
    "start:worker": "node --env-file-if-exists=.env apps/worker/dist/main.js",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "deps:lock": "pnpm install --lockfile-only --no-frozen-lockfile",
    "smoke:runtime": "node --env-file-if-exists=.env scripts/smoke-runtime.mjs",
    "test:stabilization": "node --test scripts/stabilization.test.mjs",
    "setup:production": "node scripts/setup-production.mjs",
    "test:product-completion": "node --test scripts/product-completion.test.mjs",
    "extension:package": "node scripts/package-extension.mjs",
    "instance:backup": "node scripts/instance-ops.mjs backup",
    "instance:restore": "node scripts/instance-ops.mjs restore",
    "instance:verify": "node scripts/instance-ops.mjs verify",
    "instance:start": "node scripts/instance-ops.mjs start",
    "instance:upgrade": "node scripts/instance-ops.mjs upgrade",
    "test:rehearsal-unit": "node --test scripts/production-rehearsal.test.mjs",
    "rehearsal:production": "node scripts/production-rehearsal.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "test:release-hardening": "node --test scripts/release-hardening.test.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "12.0.1",
    "@fastify/rate-limit": "10.3.0",
    "@nestjs/common": "11.1.9",
    "@nestjs/config": "4.0.0",
    "@nestjs/core": "11.1.9",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.0",
    "@nestjs/platform-fastify": "11.1.9",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-node": "0.57.0",
    "@prisma/client": "6.19.0",
    "bullmq": "5.0.0",
    "commander": "13.0.0",
    "discord.js": "14.19.3",
    "fastify": "5.6.2",
    "grammy": "1.35.0",
    "ioredis": "5.0.0",
    "jose": "5.0.0",
    "nanoid": "5.0.0",
    "pino": "9.7.0",
    "prom-client": "15.0.0",
    "reflect-metadata": "0.2.0",
    "rxjs": "7.8.0",
    "supertest": "7.0.0",
    "vk-io": "4.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.26.0",
    "@types/node": "22.15.3",
    "@types/supertest": "6.0.0",
    "eslint": "9.26.0",
    "prettier": "3.0.0",
    "prisma": "6.19.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vitest": "2.1.9"
  },
  "author": "SkiF4er",
  "contributors": [
    "markovav"
  ],
  "maintainers": [
    "Cajeer Team"
  ],
  "prisma": {
    "seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "fastify": "5.6.2",
      "@nestjs/common": "11.1.9",
      "@nestjs/core": "11.1.9",
      "@prisma/client": "6.19.0"
    }
  }
}
